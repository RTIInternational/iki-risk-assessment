  {
   "cell_type": "code",
   "execution_count": 142,
   "metadata": {},
   "outputs": [],
   "source": [
    "# set up hazard mapping to get final indicator value combining frequency and intensity\n",
    "hazard_matrix = {\n",
    "    4: {1: \"Medio\", 2: \"Alto\", 3: \"Muy alto\", 4: \"Muy alto\"},\n",
    "    3: {1: \"Medio\",  2: \"Alto\", 3: \"Alto\",     4: \"Muy alto\"},\n",
    "    2: {1: \"Bajo\",  2: \"Medio\",  3: \"Alto\",    4: \"Alto\"},\n",
    "    1: {1: \"Bajo\",  2: \"Bajo\",  3: \"Medio\",    4: \"Medio\"},\n",
    "}\n",
    "\n",
    "hazard_to_val = {\n",
    "    \"Bajo\": 1,\n",
    "    \"Medio\": 2,\n",
    "    \"Alto\": 3,\n",
    "    \"Muy alto\": 4\n",
    "}\n",
    "\n",
    "def compute_hazard(freq_class, intens_class):\n",
    "    return hazard_matrix[freq_class][intens_class]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 143,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "{4: {1: 'Medio', 2: 'Alto', 3: 'Muy alto', 4: 'Muy alto'},\n",
       " 3: {1: 'Medio', 2: 'Alto', 3: 'Alto', 4: 'Muy alto'},\n",
       " 2: {1: 'Bajo', 2: 'Medio', 3: 'Alto', 4: 'Alto'},\n",
       " 1: {1: 'Bajo', 2: 'Bajo', 3: 'Medio', 4: 'Medio'}}"
      ]
     },
     "execution_count": 143,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "hazard_matrix"
   ]
  },
  {
   "cell_type": "code",
