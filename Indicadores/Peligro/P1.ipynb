   "source": [
    "# 3. Classify frequency ratio into hazard categories\n",
    "# (physical/interpretative thresholds)\n",
    "def classify_frequency_ratio(fr):\n",
    "    if fr >= 0.40:\n",
    "        return 4  # Muy Alta (≥ 40% del tiempo)\n",
    "    elif fr >= 0.25:\n",
    "        return 3  # Alta\n",
    "    elif fr >= 0.10:\n",
    "        return 2  # Media\n",
    "    else:\n",
    "        return 1  # Baja"
   ]
  },
  {
