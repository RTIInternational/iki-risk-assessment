    "def classify_spi_intensity(spi):\n",
    "    if spi < -2.0:\n",
    "        return 4  # eextremadamente seco\n",
    "    elif spi < -1.5:\n",
    "        return 3  # severamente seco\n",
    "    elif spi < -1.0:\n",
    "        return 2  # moderadamente seco\n",
    "    else:\n",
    "        return 1  # sin sequía o normal (leve)"
   ]
  },
