   "source": [
    "def compute_spi_n(df, window):\n",
    "    return (\n",
    "        df\n",
    "        .groupby(['ScnID', 'comid'], group_keys=False)\n",
    "        .apply(calculate_spi_for_group, window=window)\n",
    "    )"
   ]
