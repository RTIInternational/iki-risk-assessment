   "outputs": [],
   "source": [
    "freq_1['Frequency_class'] = freq_1['Frequency_ratio'].apply(classify_frequency_ratio)\n",
    "freq_3['Frequency_class'] = freq_3['Frequency_ratio'].apply(classify_frequency_ratio)\n",
    "freq_12['Frequency_class'] = freq_12['Frequency_ratio'].apply(classify_frequency_ratio)"
   ]
  },
