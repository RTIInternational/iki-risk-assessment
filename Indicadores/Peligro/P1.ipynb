   "outputs": [],
   "source": [
    "hazard_base_1['Hazard_category'] = hazard_base_1.apply(\n",
    "    lambda r: compute_hazard(r['Frequency_class'], r['Intensity_class']),\n",
    "    axis=1\n",
    ")"
   ]
  },
